  "id": "clc_2018",
  "title": "Corine Land Cover 2018, land cover polygons",
  "description": "Corine Land Cover 2018 (version 2020 20u1), the EEA's pan-European land cover inventory: 2,375,406 polygons in 44 classes, minimum mapping unit 25 ha, ETRS89 / LAEA Europe (EPSG:3035), geometry and attributes unchanged. Three layouts of the same polygons: the Europe file (2.7 GB, the data asset), one file per country under country=<XX>/ (48 files, the data-<xx> assets and the partition glob s3://parquetry/clc/2018/country=*/clc_2018.parquet), both with a bbox covering and read in place over HTTPS or the anonymous S3 endpoint s3.geomermaids.com. Derived here: land cover aggregated on H3 cells (the data-h3 asset), and a PMTiles archive for web maps, zoom 0 to 12, H3 cells up to zoom 8 then the polygons, every feature carrying its official legend colour. The country column is ours, assigned from GAUL 2024. (c) European Union, Copernicus Land Monitoring Service, European Environment Agency (EEA).",
  "keywords": [
    "CORINE",
    "CLC",
    "land cover",
    "land use",
    "Copernicus",
    "EEA",
    "Europe",
    "H3",
    "GeoParquet",
    "PMTiles"
  ],
  "license": "other",
  "attribution": "(c) European Union, Copernicus Land Monitoring Service, European Environment Agency (EEA)",
  "version": "2018",
  "updated": "2026-10-22T13:57:26Z",
  "providers": [
    {
      "name": "European Environment Agency (EEA), Copernicus Land Monitoring Service",
      "description": "Produces Corine Land Cover and distributes it under the Copernicus data policy: full, open and free access, attribution required.",
      "url": "https://land.copernicus.eu/en/products/corine-land-cover/clc2018",
      "roles": [
        "producer",
        "licensor"
      ]
    },
    {
      "name": "Geomermaids",
      "description": "Converted CLC 2018 to GeoParquet, assigned each polygon a country, split it per country, tiled it, and maintains and hosts this catalog and its data.",
      "url": "https://geoparquet.geomermaids.com/",
      "email": "gsueur@geomermaids.com",
      "roles": [
        "processor",
        "host"
      ]
    }
  ],
  "extent": {
    "spatial": {
      "bbox": [
        [
          -55.5095,
          24.4941,
          71.1178,
          72.123
        ]
      ]
    },
    "temporal": {
      "interval": [
        [
          "2017-01-01T00:00:00Z",
          "2018-12-31T23:59:59Z"
        ]
      ]
    }
  },
  "partition:scheme": "hive",
  "partition:strategy": "attribute",
  "partition:keys": [
    {
      "name": "country",
      "type": "string",
      "description": "ISO 3166-1 alpha-2 country the polygon was assigned to (Geomermaids, from GAUL 2024; Kosovo is in RS). One file per code."
    }
  ],
  "partition:file_count": 48,
  "partition:glob": "s3://parquetry/clc/2018/country=*/clc_2018.parquet",
  "table:row_count": 2375406,
  "table:primary_geometry": "Shape",
  "table:columns": [
    {
      "name": "Shape",
      "type": "GEOMETRY",
      "description": "Land cover polygon as native Parquet GEOMETRY (WKB), ETRS89 / LAEA Europe (EPSG:3035), metres. Minimum mapping unit 25 ha."
    },
    {
      "name": "OBJECTID",
      "type": "BIGINT",
      "description": "Object id from the EEA GeoPackage."
    },
    {
      "name": "Code_18",
      "type": "VARCHAR",
      "description": "CLC class, the three-digit code of the CLC nomenclature (111 continuous urban fabric ... 523 sea and ocean; 999 NODATA). The legend is in the README."
    },
    {
      "name": "Remark",
      "type": "VARCHAR",
      "description": "EEA remark on the polygon, mostly empty."
    },
    {
      "name": "Area_Ha",
      "type": "DOUBLE",
      "description": "Polygon area in hectares, as the EEA computed it."
    },
    {
      "name": "ID",
      "type": "VARCHAR",
      "description": "EEA polygon id (EU_<n>), unique across Europe."
    },
    {
      "name": "country",
      "type": "VARCHAR",
      "description": "ISO 3166-1 alpha-2 country, added by Geomermaids (not part of CLC): the GAUL 2024 country the polygon overlaps most, or the nearest one. Polygons are never cut. Also the partition key."
    },
    {
      "name": "bbox",
      "type": "STRUCT(xmin DOUBLE, ymin DOUBLE, xmax DOUBLE, ymax DOUBLE)",
      "description": "Per-row bounding box (xmin, ymin, xmax, ymax) in EPSG:3035 metres, declared as the GeoParquet covering. Filter on it to prune row groups."
    }
  ],
