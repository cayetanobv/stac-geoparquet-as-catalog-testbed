  "id": "deforestation-year",
  "title": "TMF Deforestation Year",
  "description": "JRC Tropical Moist Forests (TMF) v1.2025: the calendar year in which each 30 m cell was first deforested (0 = never), one COG per tile. Produced by the European Commission Joint Research Centre; mirrored by Epoch as north-up ZSTD COGs with pixel values unchanged. 86 tiles of about 10 by 10 degrees in EPSG:4326 at 0.00026949 degrees (about 30 m). Pixel values are calendar years (1984 to 2025), not classes; 0 means the event never happened. The files declare no NoData value. See [AGENTS.md](AGENTS.md) for tested access recipes.",
  "license": "other",
  "keywords": [
    "tropical moist forest",
    "deforestation",
    "forest degradation",
    "JRC",
    "Landsat"
  ],
  "providers": [
    {
      "name": "European Commission, Joint Research Centre (JRC)",
      "roles": [
        "producer",
        "licensor"
      ],
      "url": "https://forobs.jrc.ec.europa.eu/TMF"
    },
    {
      "name": "Epoch",
      "description": "Re-encoded the JRC tiles as north-up ZSTD COGs, pixel values unchanged, and hosts them on Source Cooperative.",
      "roles": [
        "processor",
        "host"
      ],
      "url": "https://epoch.blue"
    }
  ],
  "extent": {
    "spatial": {
      "bbox": [
        [
          -110.000144,
          -40.107801,
          180.0,
          30.09473
        ]
      ]
    },
    "temporal": {
      "interval": [
        [
          "1984-01-01T00:00:00Z",
          "2025-12-31T23:59:59Z"
        ]
      ]
    }
