              "value": 1,
              "name": "undisturbed_forest",
              "title": "Undisturbed tropical moist forest",
              "color_hint": "005A00"
            },
            {
              "value": 2,
              "name": "degraded_forest",
              "title": "Degraded tropical moist forest",
              "color_hint": "649B23"
            },
            {
              "value": 3,
              "name": "other_land_cover",
              "title": "Other land cover",
              "color_hint": "FFFFFF"
            }
          ]
        }
      ]
