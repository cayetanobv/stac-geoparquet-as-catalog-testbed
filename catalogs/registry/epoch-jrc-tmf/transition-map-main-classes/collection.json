      "title": "TMF Transition Map, main classes (COG)",
      "bands": [
        {
          "name": "TransitionMap_MainClasses",
          "description": "Transition class at the end of 2025, 9 classes. Value 0 is not in the JRC legend; the files declare no NoData value.",
