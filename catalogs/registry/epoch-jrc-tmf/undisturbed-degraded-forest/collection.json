  "id": "undisturbed-degraded-forest",
  "title": "TMF Undisturbed and Degraded Forest",
  "description": "JRC Tropical Moist Forests (TMF) v1.2025: whether each 30 m cell is undisturbed or degraded tropical moist forest at the end of 2025, one COG per tile. Produced by the European Commission Joint Research Centre; mirrored by Epoch as north-up ZSTD COGs with pixel values unchanged. 86 tiles of about 10 by 10 degrees in EPSG:4326 at 0.00026949 degrees (about 30 m). See [AGENTS.md](AGENTS.md) for tested access recipes.",
  "license": "other",
  "keywords": [
    "tropical moist forest",
    "deforestation",
    "forest degradation",
    "JRC",
    "Landsat"
  ],
  "providers": [
    {
      "name": "European Commission, Joint Research Centre (JRC)",
      "roles": [
        "producer",
        "licensor"
      ],
      "url": "https://forobs.jrc.ec.europa.eu/TMF"
    },
    {
      "name": "Epoch",
      "description": "Re-encoded the JRC tiles as north-up ZSTD COGs, pixel values unchanged, and hosts them on Source Cooperative.",
      "roles": [
        "processor",
        "host"
      ],
      "url": "https://epoch.blue"
    }
  ],
