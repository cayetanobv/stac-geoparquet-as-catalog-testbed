      "title": "TMF Undisturbed and Degraded Forest (COG)",
      "bands": [
        {
          "name": "UndisturbedDegradedForest",
          "description": "1 undisturbed, 2 degraded tropical moist forest, 3 other land cover. Value 0 is not in the JRC legend; the files declare no NoData value.",
          "data_type": "uint8",
          "raster:sampling": "area",
          "raster:spatial_resolution": 30.0,
          "classification:classes": [
