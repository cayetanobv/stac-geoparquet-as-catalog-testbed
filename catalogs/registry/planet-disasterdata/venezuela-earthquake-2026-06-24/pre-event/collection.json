    {
      "name": "Planet Labs PBC",
      "description": "Planet Crisis Response Program",
      "roles": [
        "producer",
        "processor",
        "licensor",
        "host"
      ],
      "url": "https://www.planet.com/disasterdata/",
      "email": "crisis-response@planet.com"
    }
  ],
