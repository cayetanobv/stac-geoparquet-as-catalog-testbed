      "doi": "10.1126/sciadv.abe1603",
      "citation": "Vancutsem, C., Achard, F., Pekel, J.-F., et al. (2021). Long-term (1990-2019) monitoring of forest cover changes in the humid tropics. Science Advances."
    }
  ],
  "item_assets": {
    "data": {
      "type": "image/tiff; application=geotiff; profile=cloud-optimized",
      "roles": [
        "data"
      ],
      "title": "TMF Deforestation Year (COG)",
      "bands": [
        {
          "name": "DeforestationYear",
          "description": "Calendar year of first deforestation, 1984 to 2025; 0 = never deforested.",
          "data_type": "uint16",
          "raster:sampling": "area",
          "raster:spatial_resolution": 30.0
        }
      ]
    }
  },
