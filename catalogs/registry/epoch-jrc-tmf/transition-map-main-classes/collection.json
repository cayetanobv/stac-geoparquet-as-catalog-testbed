              "name": "converted_to_other",
              "title": "Deforested land — converted to other land cover",
              "color_hint": "FFE664"
            },
            {
              "value": 50,
              "name": "ongoing_change_2023_2025",
              "title": "Ongoing deforestation/degradation (2023–2025)",
